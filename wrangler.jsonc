// Ziptastic API on Cloudflare Workers. public/ holds the landing page's logo (served free as a
// static asset); every other request runs worker/index.js.
// The custom domains replace the zone's DNS records for those hostnames. Before the 2026-10-29
// cutover they were proxied A records to DreamHost (67.205.30.97).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ziptastic",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "ziptasticapi.com", "custom_domain": true },
    { "pattern": "www.ziptasticapi.com", "custom_domain": true }
  ],
  // Logs for 1 request in 10: plenty to debug with, and keeps a busy month well inside the
  // Workers Paid log allowance.
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
